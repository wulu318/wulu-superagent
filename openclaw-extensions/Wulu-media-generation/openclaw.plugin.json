{
  "id": "Wulu-media-generation",
  "name": "WULUMediaGeneration",
  "description": "Image/video generation and AI skin management tools powered by wulu.",
  "contracts": {
    "tools": [
      "wulu_image_generate",
      "wulu_video_generate",
      "wulu_skin_manage"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "callbackUrl": {
        "type": "string",
        "description": "wulu HTTP callback URL for media generation requests"
      },
      "secret": {
        "type": "string",
        "description": "Shared secret for callback authentication"
      },
      "requestTimeoutMs": {
        "type": "number",
        "minimum": 1000,
        "description": "Request timeout in milliseconds"
      }
    }
  }
}
